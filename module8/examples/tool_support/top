#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55d635e4be90 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55d635e23490 .scope module, "top" "top" 3 6;
 .timescale 0 0;
    .scope S_0x55d635e23490;
T_0 ;
    %vpi_call/w 3 8 "$display", "=== Module 8: Tool support summary ===" {0 0 0};
    %vpi_call/w 3 9 "$display", "  Simulators: 1364-2001/2005; 1800 subset varies by tool" {0 0 0};
    %vpi_call/w 3 10 "$display", "  Synthesis:  Synthesizable subset of 1364 and/or 1800; revision varies" {0 0 0};
    %vpi_call/w 3 11 "$display", "  Lint:       1364 and 1800; often selectable revision" {0 0 0};
    %vpi_call/w 3 12 "$display", "  Formal:     Assertions/checkers (1800); revision varies" {0 0 0};
    %vpi_call/w 3 13 "$display", "  Icarus:     Primarily 1364-2001/2005; limited SystemVerilog" {0 0 0};
    %vpi_call/w 3 14 "$display", "  Verilator:  1364 and growing 1800 subset" {0 0 0};
    %vpi_call/w 3 15 "$display", "  Commercial (VCS, Questa, Xcelium): Typically 1800-2005 through 1800-2017" {0 0 0};
    %vpi_call/w 3 16 "$display", "  Match project standard to simulator, synthesis, and IP support." {0 0 0};
    %vpi_call/w 3 17 "$display", "=== End tool support ===" {0 0 0};
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "tool_support.sv";
