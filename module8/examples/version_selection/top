#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x560951243490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x560951243640 .scope module, "top" "top" 3 6;
 .timescale 0 0;
    .scope S_0x560951243640;
T_0 ;
    %vpi_call/w 3 8 "$display", "=== Module 8: Version selection quick reference ===" {0 0 0};
    %vpi_call/w 3 9 "$display", "  Match: project standard to simulator, synthesis, and IP support" {0 0 0};
    %vpi_call/w 3 10 "$display", "  State: one revision (e.g. IEEE 1800-2017) and subset (e.g. design only, no SVA in RTL)" {0 0 0};
    %vpi_call/w 3 11 "$display", "  Document: in style guide or README; reference LRM and tool manuals" {0 0 0};
    %vpi_call/w 3 12 "$display", "  Verilog-only: use when tools or IP require 1364; 1364-2005 as reference" {0 0 0};
    %vpi_call/w 3 13 "$display", "  SystemVerilog design: use when flow supports 1800; 1800-2017 as reference" {0 0 0};
    %vpi_call/w 3 14 "$display", "  Full checklist: docs/MODULE7.md (version-selection checklist)" {0 0 0};
    %vpi_call/w 3 15 "$display", "=== End version selection ===" {0 0 0};
    %vpi_call/w 3 16 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "version_selection.sv";
