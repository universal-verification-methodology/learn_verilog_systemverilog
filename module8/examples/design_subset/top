#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5636386ac490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5636386ac640 .scope module, "top" "top" 3 6;
 .timescale 0 0;
    .scope S_0x5636386ac640;
T_0 ;
    %vpi_call/w 3 8 "$display", "=== Module 8: Design subset quick reference ===" {0 0 0};
    %vpi_call/w 3 9 "$display", "  Verilog-only (1364):" {0 0 0};
    %vpi_call/w 3 10 "$display", "    Ports: ANSI (2001+) or non-ANSI (1995)" {0 0 0};
    %vpi_call/w 3 11 "$display", "    Types: wire, reg (no logic)" {0 0 0};
    %vpi_call/w 3 12 "$display", "    Comb: always @* or always @(inputs)" {0 0 0};
    %vpi_call/w 3 13 "$display", "    Seq:  always @(posedge clk) with <=" {0 0 0};
    %vpi_call/w 3 14 "$display", "    No: logic, always_comb/always_ff, interfaces, packages, unique/priority case" {0 0 0};
    %vpi_call/w 3 15 "$display", "  SystemVerilog design (1800):" {0 0 0};
    %vpi_call/w 3 16 "$display", "    Ports: ANSI; logic typical" {0 0 0};
    %vpi_call/w 3 17 "$display", "    Types: logic (single driver)" {0 0 0};
    %vpi_call/w 3 18 "$display", "    Comb: always_comb" {0 0 0};
    %vpi_call/w 3 19 "$display", "    Seq:  always_ff with <=" {0 0 0};
    %vpi_call/w 3 20 "$display", "    Connectivity: interface+modport; package+import; unique/priority case" {0 0 0};
    %vpi_call/w 3 21 "$display", "  Use 1364 when: tools or IP require Verilog only" {0 0 0};
    %vpi_call/w 3 22 "$display", "  Use 1800 when: flow supports 1800; preferred for new RTL" {0 0 0};
    %vpi_call/w 3 23 "$display", "=== End design subset ===" {0 0 0};
    %vpi_call/w 3 24 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "design_subset.sv";
